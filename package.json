{
  "name": "build-your-own-data-stack",
  "version": "0.1.0",
  "description": "Learn data infrastructure by rebuilding it from first principles — an interactive, community-curated learning map.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "keywords": [
    "data-engineering",
    "learning",
    "databases",
    "storage-engines",
    "query-engines",
    "from-scratch",
    "education"
  ],
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "start": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "catalog:validate": "tsx scripts/validate.ts",
    "catalog:generate": "tsx scripts/generate.ts",
    "links:check": "tsx scripts/check-links.ts"
  },
  "dependencies": {
    "astro": "^7.1.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
